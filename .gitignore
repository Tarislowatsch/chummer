# Residue of the legacy chummergen auto-updater (removed in P3-02).
# data/*.zip are downloaded update payloads that get unpacked into the .xml
# beside them, so they must never shadow the real rule data in Chummer/data.
Chummer/data/*.zip
manifestdata.xml
manifestlang.xml
