<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converted from the 1,053-line old-style project file in P0-12. What was in
       it: ~230 <Compile> entries, ~90 <EmbeddedResource> entries, 56 single-item
       <ItemGroup> blocks holding one icon PNG each, a ClickOnce bootstrapper
       block nobody ever published from, and 12 <Reference> entries. All of that
       is either globbed or supplied by the SDK now. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Chummer</RootNamespace>
    <AssemblyName>Chummer</AssemblyName>
    <ApplicationIcon>chummer.ico</ApplicationIcon>
    <!-- app.config declares the supported runtime (P0-10) and has to become
         Chummer.exe.config in the output. Named explicitly rather than relying
         on the SDK finding it, because a silently missing .exe.config would put
         the application back on 4.0 semantics without any build diagnostic. -->
    <AppConfig>app.config</AppConfig>
    <!-- ChummerCS.sln identifies the project by this GUID. -->
    <ProjectGuid>{95279469-5A3E-42E6-993C-6A403586C86E}</ProjectGuid>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Properties\AssemblyInfo.cs is hand-maintained and holds the version that
         frmAbout shows and that Character.Save stamps into every .chum file as
         <appversion>, so the SDK must not generate a competing set of assembly
         attributes. TargetFrameworkAttribute is the exception and stays on: the
         .NET Framework reads it to decide whether a process gets 4.8 behaviour
         or 4.0 quirks mode, and the old build emitted it as well. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>true</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <PropertyGroup>
    <!-- x86 only, as decided in P0-11: the application hosts the Internet
         Explorer ActiveX WebBrowser control and is 32-bit in practice.
         PlatformTarget is unconditional so that a build invoked without an
         explicit Platform, where the default is AnyCPU, still produces a 32-bit
         executable rather than a subtly different one. -->
    <Platforms>x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Keep the output where it has always been, bin\Debug and bin\Release.
         The SDK default would be bin\x86\Debug\net48: with one target framework
         and one platform those two extra levels carry no information, and they
         would invalidate the CI content check, docs/BUILDING.md and every
         existing shortcut for no gain. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nine of the twelve former references are gone: eight come from the SDK's
         implicit .NET Framework set (System, System.Core, System.Data,
         System.Drawing, System.Runtime.Serialization, System.Xml,
         System.Xml.Linq, Microsoft.CSharp) and System.Windows.Forms from
         UseWindowsForms. These three do not, and none of them is a NuGet
         package - they are framework assemblies from the targeting pack:
         System.ServiceModel for the Omae WCF proxies, WindowsBase for the
         System.IO.Packaging use in clsOmaeHelper.Decompress, and
         DataVisualization for the two charts in frmCareer. P3-04 and P3-09
         remove the first two; the chart reference stays. -->
    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Windows.Forms.DataVisualization" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- InheritedListView.cs exists in the source tree but was never listed in
         the old project file - it has a single commit, the 2013 import, and no
         reference anywhere in the codebase. It has therefore never been
         compiled. The SDK's **/*.cs glob would quietly start compiling it and
         add an unused Chummer.MyListView type to the assembly, which is a change
         to what the build produces and thus outside Phase 0. Left excluded and
         left in place; deciding whether to delete it belongs to Phase 3, where
         dead code is the subject. -->
    <Compile Remove="InheritedListView.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only two pieces of designer metadata worth carrying over. Without
         them Visual Studio stops regenerating Resources.Designer.cs and
         Settings.Designer.cs when the .resx or the .settings file is edited,
         and the breakage is silent. The ~90 other DependentUpon entries are
         obsolete: the SDK pairs frmX.resx with frmX.cs by convention and
         derives the same manifest resource names the old file produced. -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Runtime content: game data, translations, character sheets, export
       templates, default settings and the changelog shown by frmHistory.
       Without these the build produces an executable that cannot start, since
       every one of them is read from Application.StartupPath at run time (P0-13).
       Extensions are listed explicitly rather than using *.* so that downloaded
       updater payloads (data\*.zip) and editor backups are never copied.
       The None Remove lines keep these files from appearing as both None and
       Content, which is what the SDK's default None glob would otherwise do. -->
  <ItemGroup>
    <None Remove="data\**;lang\**;sheets\**;export\**;settings\**;changelog.txt" />
    <Content Include="data\**\*.xml;data\**\*.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="lang\**\*.xml;lang\**\*.xsd" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sheets\**\*.xsl;sheets\**\*.xslt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="export\**\*.xsl;export\**\*.xslt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="settings\**\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="changelog.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
