<?xml version="1.0" encoding="utf-8"?>
<!-- - a run that discovers no tests must fail: a broken adapter otherwise exits 0 -->
<!-- - wired in through tests/Directory.Build.props for every test project -->
<RunSettings>
  <RunConfiguration>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
</RunSettings>
